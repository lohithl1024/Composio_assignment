<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
    <style>
      :root {
        --bg: #ffffff;
        --paper: #ffffff;
        --ink: #0b0b0b;
        --muted: #6f6f6f;
        --soft: #f7f7f7;
        --line: #e9e9e9;
        --accent: #0f766e;
        --accent-soft: #e6f4f1;
        --green: #15803d;
        --amber: #b45309;
        --red: #b91c1c;
        --gray: #52525b;
        --radius: 18px;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: Georgia, "Iowan Old Style", "Palatino Linotype", Palatino, "Times New Roman", serif;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.55;
      }

      a { color: inherit; text-decoration: none; }
      a:hover { color: var(--accent); }

      .muted {
        color: var(--muted);
      }

      .shell {
        width: min(1500px, calc(100% - 72px));
        margin: 0 auto;
      }

      .topnav {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(255, 255, 255, 0.92);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(18px);
      }

      .topnav-inner {
        min-height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        font-weight: 700;
        font-size: clamp(19px, 1.35vw, 24px);
        letter-spacing: 0;
      }

      .navlinks {
        display: flex;
        gap: clamp(16px, 2vw, 34px);
        align-items: center;
        color: var(--muted);
        font-size: clamp(15px, 1.18vw, 21px);
        font-weight: 500;
      }

      .navlinks a.active {
        color: var(--ink);
      }

      .page {
        padding: 112px 0 84px;
      }

      .eyebrow {
        margin-bottom: 18px;
        color: var(--muted);
        font-size: clamp(15px, 1.08vw, 19px);
        font-weight: 500;
        letter-spacing: 0;
        text-transform: none;
      }

      h1, h2, h3, p { margin-top: 0; }
      h1 {
        max-width: 1240px;
        margin-bottom: 28px;
        font-size: clamp(46px, 7.2vw, 104px);
        font-weight: 800;
        line-height: 0.94;
        letter-spacing: -0.04em;
      }

      h2 {
        margin-bottom: 18px;
        font-size: clamp(32px, 3.8vw, 56px);
        font-weight: 800;
        line-height: 0.98;
        letter-spacing: -0.035em;
      }

      h3 {
        margin-bottom: 8px;
        font-size: clamp(19px, 1.35vw, 25px);
        font-weight: 700;
        line-height: 1.15;
      }

      .lead {
        max-width: 1120px;
        color: var(--muted);
        font-size: clamp(19px, 1.65vw, 28px);
        line-height: 1.58;
      }

      .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 30px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 18px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--paper);
        color: var(--muted);
        font-size: 14px;
        font-weight: 600;
      }

      .button.primary {
        border-color: var(--ink);
        background: var(--ink);
        color: #ffffff;
      }

      .stat-pills {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 28px;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 36px;
        padding: 0 13px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: #ffffff;
        color: var(--muted);
        font-size: 13px;
        font-weight: 500;
      }

      .pill strong { color: var(--ink); }

      .dataset-preview {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(300px, 0.45fr);
        gap: 24px;
        align-items: stretch;
      }

      .dataset-card {
        padding: 28px;
        border: 1px solid var(--line);
        border-radius: 28px;
        background: var(--paper);
      }

      .dataset-card p {
        color: var(--muted);
        font-size: 17px;
      }

      .dataset-card .button {
        margin-top: 14px;
      }

      .dataset-preview .grid-3 {
        grid-template-columns: 1fr;
      }

      .section {
        padding: 88px 0;
        border-top: 1px solid var(--line);
      }

      .section-head {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(340px, 0.55fr);
        gap: 42px;
        align-items: end;
        margin-bottom: 38px;
      }

      .section-head p {
        color: var(--muted);
        font-size: clamp(16px, 1.25vw, 21px);
        line-height: 1.55;
        margin-bottom: 0;
      }

      .agent-scroll-box {
        border: 1px solid var(--line);
        border-radius: 34px;
        background: #ffffff;
        padding: 20px 20px 42px;
        overflow-x: auto;
        scrollbar-width: thin;
      }

      .agent-scroll-box::-webkit-scrollbar {
        height: 9px;
      }

      .agent-scroll-box::-webkit-scrollbar-track {
        background: #f4f4f4;
        border-radius: 999px;
      }

      .agent-scroll-box::-webkit-scrollbar-thumb {
        background: #d4d4d4;
        border-radius: 999px;
      }

      .agent-track {
        display: flex;
        gap: 22px;
        width: max-content;
      }

      .agent-card {
        position: relative;
        flex: 0 0 min(460px, 76vw);
        min-height: 238px;
        padding: 28px;
        border: 1px solid var(--line);
        border-radius: 34px 34px 34px 10px;
        background: var(--paper);
        cursor: pointer;
        transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
      }

      .agent-card::after {
        content: "";
        position: absolute;
        left: -1px;
        bottom: -22px;
        width: 44px;
        height: 42px;
        border-left: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        border-bottom-left-radius: 38px;
        background: var(--paper);
        clip-path: polygon(0 0, 100% 0, 0 100%);
      }

      .agent-card:hover,
      .agent-card.active {
        transform: translateY(-3px);
        border-color: #cfcfcf;
        background: #fcfcfc;
      }

      .agent-top {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: start;
      }

      .stage {
        color: var(--muted);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0;
        text-transform: none;
      }

      .agent-card p {
        color: var(--muted);
        font-size: 15px;
        line-height: 1.55;
        margin-bottom: 18px;
      }

      .io {
        display: grid;
        gap: 8px;
        margin-top: 16px;
        color: var(--muted);
        font-size: 12px;
      }

      .io code, .code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      }

      .agent-detail {
        margin-top: 28px;
        padding: 22px;
        border: 1px solid var(--line);
        border-radius: 24px;
        background: #ffffff;
      }

      .agent-detail pre,
      .code-block {
        margin: 14px 0 0;
        padding: 16px;
        border-radius: 14px;
        background: #0b0b0b;
        color: #f4f4f4;
        overflow: auto;
        font-size: 13px;
      }

      .flow {
        display: grid;
        grid-template-columns: repeat(6, minmax(150px, 1fr));
        gap: 14px;
        overflow-x: auto;
        padding-bottom: 8px;
      }

      .flow-node {
        position: relative;
        min-height: 156px;
        padding: 18px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--paper);
      }

      .flow-node:not(:last-child)::after {
        content: "→";
        position: absolute;
        right: -14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--muted);
        font-weight: 800;
      }

      .flow-node small {
        display: block;
        margin-top: 12px;
        color: var(--accent);
        font-size: 12px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      }

      .tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 26px;
      }

      .tab {
        min-height: 42px;
        padding: 0 16px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 14px;
        font-weight: 650;
        cursor: pointer;
      }

      .tab.active {
        border-color: var(--ink);
        background: var(--ink);
        color: #ffffff;
      }

      .tab-panel {
        padding: 26px;
        border: 1px solid var(--line);
        border-radius: 28px;
        background: var(--paper);
      }

      .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .mini-stat {
        padding: 18px;
        border: 1px solid var(--line);
        border-radius: 24px;
        background: #ffffff;
      }

      .mini-stat strong {
        display: block;
        font-size: clamp(26px, 2.25vw, 38px);
        line-height: 1;
      }

      .mini-stat span {
        display: block;
        margin-top: 12px;
        color: var(--muted);
        font-size: 13px;
      }

      .insight-list {
        display: grid;
        gap: 18px;
        margin-top: 24px;
      }

      .insight {
        display: grid;
        grid-template-columns: 32px 1fr;
        gap: 14px;
      }

      .index {
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        border-radius: 999px;
        background: #f3f3f3;
        color: var(--ink);
        font-size: 13px;
        font-weight: 850;
      }

      .bar-list {
        display: grid;
        gap: 14px;
      }

      .bar-row {
        display: grid;
        grid-template-columns: 170px 1fr 44px;
        gap: 10px;
        align-items: center;
        color: var(--muted);
        font-size: 13px;
      }

      .bar-track {
        height: 8px;
        border-radius: 999px;
        background: var(--soft);
        overflow: hidden;
      }

      .bar {
        height: 100%;
        border-radius: 999px;
        background: var(--accent);
      }

      .resource-list {
        display: grid;
        gap: 12px;
      }

      .resource {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid var(--line);
      }

      .resource:last-child { border-bottom: 0; }

      .dataset-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 18px;
        align-items: start;
      }

      .filter-bar {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        padding: 14px;
        border: 1px solid var(--line);
        border-bottom: 0;
        border-radius: var(--radius) var(--radius) 0 0;
        background: var(--paper);
      }

      input, select {
        min-height: 40px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: #fff;
        padding: 0 12px;
        color: var(--ink);
        font: inherit;
      }

      input { min-width: 260px; flex: 1; }

      .table-wrap {
        max-height: 760px;
        overflow: auto;
        border: 1px solid var(--line);
        border-radius: 0 0 var(--radius) var(--radius);
        background: var(--paper);
      }

      table {
        width: 100%;
        min-width: 1040px;
        border-collapse: collapse;
      }

      th, td {
        padding: 12px 12px;
        border-bottom: 1px solid var(--line);
        text-align: left;
        vertical-align: top;
        font-size: 13px;
      }

      th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #fafafa;
        color: var(--muted);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      tr[data-clickable="true"] { cursor: pointer; }
      tr[data-clickable="true"]:hover { background: #fafafa; }

      .app-cell {
        display: flex;
        gap: 10px;
        align-items: start;
      }

      .logo {
        flex: 0 0 auto;
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: #ffffff;
        color: var(--ink);
        font-weight: 700;
        overflow: hidden;
      }

      .logo img {
        width: 22px;
        height: 22px;
        object-fit: contain;
      }

      .logo span {
        display: none;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        min-height: 24px;
        padding: 3px 8px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 760;
        white-space: nowrap;
      }

      .badge.green { background: #dcfce7; color: var(--green); }
      .badge.amber { background: #fef3c7; color: var(--amber); }
      .badge.red { background: #fee2e2; color: var(--red); }
      .badge.gray { background: #f1f5f9; color: var(--gray); }
      .badge.teal { background: var(--accent-soft); color: var(--accent); }

      .detail-panel {
        position: sticky;
        top: 88px;
        padding: 22px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--paper);
      }

      .detail-panel dl {
        display: grid;
        gap: 14px;
        margin: 18px 0 0;
      }

      .detail-panel dt {
        color: var(--muted);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .detail-panel dd {
        margin: 2px 0 0;
      }

      .workflow-stage {
        padding: 24px 0;
        border-top: 1px solid var(--line);
      }

      .workflow-stage:first-child { border-top: 0; }

      .footer {
        padding: 54px 0;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 18px;
      }

      @media (max-width: 900px) {
        .section-head, .grid-2, .grid-3, .dataset-layout, .dataset-preview {
          grid-template-columns: 1fr;
        }

        .flow {
          grid-template-columns: repeat(6, 190px);
          overflow-x: auto;
        }

        .detail-panel {
          position: static;
        }
      }

      @media (max-width: 640px) {
        .shell { width: min(100% - 28px, 1500px); }
        .page { padding-top: 72px; }
        .topnav-inner {
          min-height: auto;
          padding: 14px 0;
          display: block;
        }
        .navlinks {
          margin-top: 10px;
          gap: 12px;
        }
        .agent-card, .tab-panel { padding: 20px; }
        .agent-scroll-box { padding: 16px 16px 42px; border-radius: 24px; }
        .agent-card { flex-basis: min(420px, 84vw); min-height: 260px; }
        .bar-row { grid-template-columns: 112px 1fr 36px; }
      }
    </style>
  </head>
  <body>
    <header class="topnav">
      <div class="shell topnav-inner">
        <a class="brand" href="{{ base_path }}index.html">Lohith</a>
        <nav class="navlinks">
          <a href="{{ base_path }}index.html#agents">Agents</a>
          <a href="{{ base_path }}index.html#outputs">Outputs</a>
          <a href="{{ base_path }}index.html#dataset">Dataset</a>
          <a href="{{ base_path }}workflow/index.html">Workflow</a>
        </nav>
      </div>
    </header>

    <main class="shell page" id="app"></main>
    <footer class="shell footer">A repeatable research workflow for deciding which app integrations Composio can ship now, which need outreach, and which still require human review.</footer>

    <script id="analysis-data" type="application/json">{{ analysis_json | safe }}</script>
    <script id="table-data" type="application/json">{{ table_json | safe }}</script>
    <script id="verification-data" type="application/json">{{ verification_json | safe }}</script>
    <script>
      const PAGE = "{{ page }}";
      const BASE = "{{ base_path }}";
      const analysis = JSON.parse(document.querySelector("#analysis-data").textContent);
      const apps = JSON.parse(document.querySelector("#table-data").textContent);
      const verification = JSON.parse(document.querySelector("#verification-data").textContent);
      const app = document.querySelector("#app");

      const countOf = (dist, key) => dist?.[key]?.count || 0;
      const titleize = (value) => String(value || "unclear").replaceAll("_", " ");
      const fmtPct = (value) => `${Number(value || 0).toFixed(1)}%`;
      const url = (path) => `${BASE}${path}`;

      const agents = [
        {
          id: "discovery",
          name: "Discovery Agent",
          stage: "Stage 01",
          role: "Builds the app's source packet by locating official docs, auth pages, pricing/access evidence, and MCP references.",
          focus: "source trust + evidence coverage",
          input: "app_name, category, website_hint",
          output: "app_records.discovered.jsonl",
          syntax: "DiscoveryAgent.run(app_record)\\n  focus: source trust + evidence coverage\\n  input: app_name, category, website_hint\\n  output: app_records.discovered.jsonl"
        },
        {
          id: "extraction",
          name: "Extraction Agent",
          stage: "Stage 02",
          role: "Turns source packets into structured research fields for auth, access, API surface, MCP status, and buildability.",
          focus: "schema mapping + buildability judgment",
          input: "discovered_record, source_packet",
          output: "app_records.extracted.jsonl",
          syntax: "ExtractionAgent.run(discovered_record, source_packet)\\n  focus: schema mapping + buildability judgment\\n  output: app_records.extracted.jsonl"
        },
        {
          id: "verification",
          name: "Verification Agent",
          stage: "Stage 03",
          role: "Audits sampled rows against source evidence to check whether key claims are correct, partial, or unresolved.",
          focus: "claim validation + QA flags",
          input: "extracted_rows, evidence",
          output: "app_records.verified.jsonl",
          syntax: "VerificationAgent.audit(extracted_rows, evidence)\\n  focus: claim validation + QA flags\\n  output: app_records.verified.jsonl"
        },
        {
          id: "analysis",
          name: "Analysis Agent",
          stage: "Stage 04",
          role: "Converts verified rows into buildability patterns, blocker trends, category summaries, and the final visible dataset.",
          focus: "patterns + build / outreach queues",
          input: "verified_records, verification_summary",
          output: "analysis_summary.json",
          syntax: "AnalysisAgent.summarize(verified_records, verification_summary)\\n  focus: patterns + build / outreach queues\\n  output: analysis_summary.json"
        }
      ];

      function badgeClass(value) {
        if (["buildable_now", "high", "self_serve_free_or_trial", "none", "yes"].includes(value)) return "green";
        if (["buildable_with_caveats", "medium", "admin_or_workspace_dependent"].includes(value)) return "teal";
        if (["possible_but_gated", "self_serve_paid_plan_required", "partial", "corrected"].includes(value)) return "amber";
        if (["unclear", "unclear_needs_review", "low", "partner_or_contact_sales_gated", "flagged"].includes(value)) return "red";
        return "gray";
      }

      function hero() {
        const build = analysis.buildability_distribution;
        return `
          <section>
            <div class="eyebrow">Composio Take-home · Agentic Integration Research</div>
            <h1>Composio Analyzer</h1>
            <p class="lead">A 100-app map of toolkit readiness for Composio. I built an agentic research pipeline that classifies requested apps by auth, access friction, API surface, MCP evidence, and buildability, then audits the output to keep uncertain rows visible instead of hiding them.</p>
            <div class="stat-pills">
              <span class="pill"><strong>${analysis.dataset_summary.total_apps}</strong> apps researched</span>
              <span class="pill"><strong>${analysis.dataset_summary.with_evidence}</strong> rows with evidence</span>
              <span class="pill"><strong>${verification.sample_size}</strong>-app verification sample</span>
              <span class="pill"><strong>${countOf(build, "buildable_now")}</strong> buildable now</span>
              <span class="pill"><strong>${countOf(build, "buildable_with_caveats")}</strong> caveats · <strong>${countOf(build, "possible_but_gated") + countOf(build, "unclear_needs_review")}</strong> gated/review</span>
            </div>
            <div class="hero-actions">
              <a class="button primary" href="${url("dataset/index.html")}">Open dataset</a>
              <a class="button" href="${url("workflow/index.html")}">View workflow</a>
            </div>
          </section>
        `;
      }

      function homePage() {
        app.innerHTML = `
          ${hero()}
          ${agentsPreview()}
          ${datasetPreview()}
          ${outputs()}
        `;
        setupAgents();
        setupTabs();
      }

      function agentsPreview() {
        return `
          <section class="section" id="agents">
            <div class="section-head">
              <div>
                <div class="eyebrow">Agents used</div>
                <h2>Specialized stages, concrete outputs.</h2>
              </div>
              <p>The system is split into narrow agents so each step has one job, one input contract, and one artifact it emits.</p>
            </div>
            <div class="agent-scroll-box" aria-label="Horizontally scrollable agent cards">
              <div class="agent-track">
                ${agents.map((agent) => agentCard(agent)).join("")}
              </div>
            </div>
            <div class="agent-detail" id="agentDetail"></div>
          </section>
        `;
      }

      function agentCard(agent) {
        return `
          <article class="agent-card" data-agent="${agent.id}" tabindex="0">
            <div class="agent-top">
              <div>
                <div class="stage">${agent.stage}</div>
                <h3>${agent.name}</h3>
              </div>
            </div>
            <p>${agent.role}</p>
            <div class="io">
              <div><strong>focus:</strong> <code>${agent.focus}</code></div>
              <div><strong>input:</strong> <code>${agent.input}</code></div>
              <div><strong>output:</strong> <code>${agent.output}</code></div>
            </div>
          </article>
        `;
      }

      function setupAgents() {
        const detail = document.querySelector("#agentDetail");
        if (!detail) return;
        const render = (agent) => {
          document.querySelectorAll(".agent-card").forEach((card) => card.classList.toggle("active", card.dataset.agent === agent.id));
          detail.innerHTML = `<h3>${agent.name} contract</h3><p class="muted">${agent.role}</p><pre>${agent.syntax}</pre>`;
        };
        render(agents[0]);
        document.querySelectorAll(".agent-card").forEach((card) => {
          card.addEventListener("click", () => render(agents.find((agent) => agent.id === card.dataset.agent)));
          card.addEventListener("keydown", (event) => {
            if (event.key === "Enter") render(agents.find((agent) => agent.id === card.dataset.agent));
          });
        });
      }

      function datasetPreview() {
        return `
          <section class="section" id="dataset">
            <div class="section-head">
              <div>
                <div class="eyebrow">Dataset</div>
                <h2>Research matrix for all 100 apps.</h2>
              </div>
              <p>The complete reviewer-facing table is separated from the story page so the findings stay readable and the raw research remains easy to inspect.</p>
            </div>
            <div class="dataset-preview">
              <div class="dataset-card">
                <h3>100-app integration readiness matrix</h3>
                <p>Search every requested app by category, auth method, access model, API surface, MCP status, buildability verdict, blocker, confidence, and evidence links.</p>
                <a class="button primary" href="${url("dataset/index.html")}">Open research matrix</a>
              </div>
              <div class="grid-3">
                ${miniStat(analysis.dataset_summary.total_apps, "apps researched")}
                ${miniStat(analysis.dataset_summary.with_evidence, "rows with evidence")}
                ${miniStat(analysis.dataset_summary.low_confidence_rows, "low-confidence rows")}
              </div>
            </div>
          </section>
        `;
      }

      function outputs() {
        return `
          <section class="section" id="outputs">
            <div class="section-head">
              <div><div class="eyebrow">Outputs / observations</div><h2>Findings, patterns, agents, and links.</h2></div>
              <p>The main page stays neat: click each output to inspect the result without turning the page into a dashboard.</p>
            </div>
            <div class="tabs">
              ${["findings", "patterns", "agents", "links"].map((tab, index) => `<button class="tab ${index === 0 ? "active" : ""}" data-tab="${tab}">${titleize(tab)}</button>`).join("")}
            </div>
            <div class="tab-panel" id="tabPanel"></div>
          </section>
        `;
      }

      function setupTabs() {
        const panel = document.querySelector("#tabPanel");
        if (!panel) return;
        const render = (tab) => {
          document.querySelectorAll(".tab").forEach((button) => button.classList.toggle("active", button.dataset.tab === tab));
          panel.innerHTML = tabs[tab]();
        };
        document.querySelectorAll(".tab").forEach((button) => button.addEventListener("click", () => render(button.dataset.tab)));
        render("findings");
      }

      const tabs = {
        findings: () => `
          <div class="grid-3">
            ${miniStat(`${countOf(analysis.buildability_distribution, "buildable_now")} / 100`, "buildable now")}
            ${miniStat(`${countOf(analysis.buildability_distribution, "buildable_with_caveats")} / 100`, "buildable with caveats")}
            ${miniStat(`${countOf(analysis.buildability_distribution, "possible_but_gated") + countOf(analysis.buildability_distribution, "unclear_needs_review")} / 100`, "gated or needs review")}
          </div>
          <div class="insight-list">
            ${[
              ["Most apps were still buildable without a partner motion", "60% of the set landed in buildable-now, suggesting public APIs and self-serve auth cover a meaningful part of requested tools."],
              ["Access friction mattered more than API existence", "The most common non-trivial blocker was admin or workspace setup, not the total absence of an API."],
              ["Support and helpdesk tools were the cleanest category", "Support/helpdesk had the strongest buildable-now share in this pass."],
              ["OAuth 2.0 and API keys dominate the known auth surface", "Where auth was clearly documented, OAuth and API-key/token flows were the main integration paths."],
              ["Verification exposed the automation boundary", "The audit showed that access model and practical readiness are harder to infer than source discovery."]
            ].map((item, index) => insight(index + 1, item[0], item[1])).join("")}
          </div>
        `,
        patterns: () => `
          <div class="grid-2">
            ${barBlock("Buildability", analysis.buildability_distribution)}
            ${barBlock("Access model", analysis.access_model_distribution)}
            ${barBlock("Main blockers", nonNone(analysis.blocker_counts))}
            ${categoryNotes()}
          </div>
        `,
        agents: () => `
          <div class="grid-2">
            ${agents.map((agent) => `<div><h3>${agent.name}</h3><p class="muted">${agent.role}</p><pre class="code-block">${agent.syntax}</pre></div>`).join("")}
          </div>
        `,
        links: () => `
          <div class="resource-list">
            ${resource("Open dataset", "Searchable 100-app matrix", url("dataset/index.html"))}
            ${resource("View workflow", "Agent contracts, verification audit, and artifacts", url("workflow/index.html"))}
            ${resource("Final CSV", "data/final/app_research_final.csv", "../data/final/app_research_final.csv")}
            ${resource("Final JSON", "data/final/app_research_final.json", "../data/final/app_research_final.json")}
          </div>
          <pre class="code-block">python3 -m src.bootstrap_records
python3 -m src.discover_sources
python3 -m src.extract_record
python3 -m src.verify_record
python3 -m src.run_analysis
python3 -m src.build_visible_dataset
python3 -m src.build_case_study</pre>
        `
      };

      function miniStat(value, label) {
        return `<div class="mini-stat"><strong>${value}</strong><span>${label}</span></div>`;
      }

      function insight(number, title, copy) {
        return `<div class="insight"><div class="index">${number}</div><div><h3>${title}</h3><p class="muted">${copy}</p></div></div>`;
      }

      function barBlock(title, distribution) {
        const entries = Object.entries(distribution || {}).slice(0, 5);
        const max = Math.max(...entries.map(([, stat]) => stat.count), 1);
        return `<div><h3>${title}</h3><div class="bar-list">${entries.map(([label, stat]) => `<div class="bar-row"><span>${titleize(label)}</span><div class="bar-track"><div class="bar" style="width:${(stat.count / max) * 100}%"></div></div><strong>${stat.count}</strong></div>`).join("")}</div></div>`;
      }

      function nonNone(distribution) {
        return Object.fromEntries(Object.entries(distribution || {}).filter(([key]) => key !== "none"));
      }

      function categoryNotes() {
        return `<div><h3>Category view</h3><div class="insight-list">
          ${insight("•", "Support & Helpdesk", "Highest buildable-now share in this pass.")}
          ${insight("•", "Developer / Infra", "Strong docs and many self-serve API paths.")}
          ${insight("•", "Ads / Fintech", "More approval, admin, and access friction.")}
        </div></div>`;
      }

      function resource(title, copy, href) {
        return `<a class="resource" href="${href}"><div><strong>${title}</strong><div class="muted">${copy}</div></div><span>↗</span></a>`;
      }

      function datasetPage() {
        app.innerHTML = `
          <section>
            <div class="eyebrow">Dataset</div>
            <h1>Research matrix</h1>
            <p class="lead">100 requested apps, flattened from the verified dataset. Search, filter, and click a row to inspect the supporting record.</p>
            <div class="stat-pills">
              <span class="pill"><strong>${apps.length}</strong> apps</span>
              <span class="pill"><strong>${analysis.dataset_summary.with_evidence}</strong> rows with evidence</span>
              <span class="pill"><strong>${analysis.dataset_summary.with_public_api}</strong> public API rows</span>
              <span class="pill"><strong>${analysis.dataset_summary.low_confidence_rows}</strong> low-confidence rows</span>
            </div>
          </section>
          <section class="section">
            <div class="dataset-layout">
              <div>
                <div class="filter-bar">
                  <input id="search" type="search" placeholder="Search apps, blockers, notes..." />
                  <select id="category"><option value="">All categories</option></select>
                  <select id="verdict"><option value="">All verdicts</option></select>
                  <select id="access"><option value="">All access</option></select>
                  <select id="confidence"><option value="">All confidence</option></select>
                </div>
                <div class="table-wrap">${tableShell()}</div>
              </div>
              <aside class="detail-panel" id="detailPanel"></aside>
            </div>
          </section>
        `;
        setupDataset();
      }

      function tableShell() {
        return `<table><thead><tr><th>App</th><th>Auth</th><th>Access</th><th>API</th><th>Buildability</th><th>Confidence</th><th>Evidence</th></tr></thead><tbody id="rows"></tbody></table>`;
      }

      function setupDataset() {
        fillSelect("#category", [...new Set(apps.map((row) => row.category))]);
        fillSelect("#verdict", [...new Set(apps.map((row) => row.buildability_verdict))]);
        fillSelect("#access", [...new Set(apps.map((row) => row.access_model))]);
        fillSelect("#confidence", [...new Set(apps.map((row) => row.confidence))]);
        renderRows(apps);
        renderDetail(apps[0]);
        ["#search", "#category", "#verdict", "#access", "#confidence"].forEach((selector) => {
          document.querySelector(selector).addEventListener("input", filterRows);
          document.querySelector(selector).addEventListener("change", filterRows);
        });
      }

      function fillSelect(selector, values) {
        const select = document.querySelector(selector);
        values.sort().forEach((value) => select.insertAdjacentHTML("beforeend", `<option value="${value}">${titleize(value)}</option>`));
      }

      function filterRows() {
        const query = document.querySelector("#search").value.toLowerCase().trim();
        const category = document.querySelector("#category").value;
        const verdict = document.querySelector("#verdict").value;
        const access = document.querySelector("#access").value;
        const confidence = document.querySelector("#confidence").value;
        const filtered = apps.filter((row) => {
          const text = Object.values(row).join(" ").toLowerCase();
          return (!query || text.includes(query)) && (!category || row.category === category) && (!verdict || row.buildability_verdict === verdict) && (!access || row.access_model === access) && (!confidence || row.confidence === confidence);
        });
        renderRows(filtered);
        renderDetail(filtered[0] || apps[0]);
      }

      function renderRows(data) {
        document.querySelector("#rows").innerHTML = data.map((row) => `
          <tr data-id="${row.app_id}" data-clickable="true">
            <td><div class="app-cell">${logoMarkup(row)}<div><strong>${row.app_name}</strong><div class="muted">${row.category}</div></div></div></td>
            <td>${row.auth_methods}</td>
            <td>${titleize(row.access_model)}</td>
            <td>${row.public_api}; ${titleize(row.api_breadth)}<div class="muted">${row.api_protocols}</div></td>
            <td><span class="badge ${badgeClass(row.buildability_verdict)}">${titleize(row.buildability_verdict)}</span></td>
            <td><span class="badge ${badgeClass(row.confidence)}">${titleize(row.confidence)}</span></td>
            <td>${evidence(row)}</td>
          </tr>
        `).join("");
        document.querySelectorAll("tr[data-id]").forEach((tr) => {
          tr.addEventListener("click", () => renderDetail(apps.find((row) => row.app_id === Number(tr.dataset.id))));
        });
      }

      function evidence(row) {
        const links = [["docs", row.developer_docs_url], ["api", row.api_docs_url], ["auth", row.auth_docs_url], ["access", row.pricing_or_access_url]].filter(([, href]) => href);
        return links.length ? links.map(([label, href]) => `<a href="${href}" target="_blank" rel="noreferrer">${label}</a>`).join(" · ") : "missing";
      }

      function domainFromUrl(value) {
        if (!value) return "";
        try {
          const normalized = value.startsWith("http") ? value : `https://${value}`;
          return new URL(normalized).hostname.replace(/^www\./, "");
        } catch {
          return "";
        }
      }

      function logoDomain(row) {
        const evidenceUrls = String(row.evidence_urls || "").split("|").map((url) => url.trim());
        const candidates = [
          row.developer_docs_url,
          row.api_docs_url,
          row.auth_docs_url,
          row.pricing_or_access_url,
          ...evidenceUrls
        ];
        return candidates.map(domainFromUrl).find(Boolean);
      }

      function logoMarkup(row) {
        const domain = logoDomain(row);
        const initial = String(row.app_name || "?").trim().charAt(0).toUpperCase() || "?";
        if (!domain) return `<div class="logo"><span style="display:grid">${initial}</span></div>`;
        const src = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64`;
        return `<div class="logo"><img src="${src}" alt="" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"><span>${initial}</span></div>`;
      }

      function renderDetail(row) {
        if (!row) return;
        document.querySelector("#detailPanel").innerHTML = `
          <div class="app-cell">${logoMarkup(row)}<div><h3>${row.app_name}</h3><div class="muted">${row.category}</div></div></div>
          <p class="muted" style="margin-top:16px">${row.what_it_does}</p>
          <dl>
            <div><dt>Buildability</dt><dd><span class="badge ${badgeClass(row.buildability_verdict)}">${titleize(row.buildability_verdict)}</span></dd></div>
            <div><dt>Main blocker</dt><dd>${titleize(row.main_blocker)}</dd></div>
            <div><dt>Access notes</dt><dd>${row.access_notes}</dd></div>
            <div><dt>API summary</dt><dd>${row.api_surface_summary}</dd></div>
            <div><dt>Evidence</dt><dd>${evidence(row)}</dd></div>
          </dl>
        `;
      }

      function workflowPage() {
        app.innerHTML = `
          <section>
            <div class="eyebrow">Workflow</div>
            <h1>Agent workflow</h1>
            <p class="lead">The research pipeline is split into discovery, extraction, verification, and analysis stages, each producing a concrete artifact for the next stage.</p>
          </section>
          ${agentsPreview()}
          <section class="section">
            <div class="section-head"><div><div class="eyebrow">Verification</div><h2>Trust layer and audit metrics.</h2></div><p>The verifier is deliberately conservative: ambiguous rows remain in review.</p></div>
            <div class="grid-3">
              ${miniStat(verification.sample_size, "sampled apps")}
              ${miniStat("120", "field-level checks")}
              ${miniStat(fmtPct(verification.first_pass_accuracy * 100), "strict field accuracy")}
              ${miniStat(fmtPct(verification.first_pass_correct_or_partial_rate * 100), "correct-or-partial")}
              ${miniStat(fmtPct(verification.unresolved_after_verification_rate * 100), "unresolved after auto-verification")}
              ${miniStat(verification.row_outcomes.flagged || 0, "flagged rows")}
            </div>
            <div class="grid-2" style="margin-top:28px">
              ${barBlock("Field-level labels", aggregateFieldLabels(verification.field_accuracy))}
              ${auditExamples()}
            </div>
          </section>
        `;
        setupAgents();
      }

      function aggregateFieldLabels(fieldAccuracy) {
        const counts = {};
        Object.values(fieldAccuracy || {}).forEach((field) => Object.entries(field).forEach(([label, count]) => counts[label] = (counts[label] || 0) + count));
        const total = Object.values(counts).reduce((sum, count) => sum + count, 0) || 1;
        return Object.fromEntries(Object.entries(counts).map(([key, count]) => [key, { count, pct: (count / total) * 100 }]));
      }

      function auditExamples() {
        const rows = verification.checks.slice(0, 7).flatMap((check) => check.fields_checked.filter((field) => field.issue_found).slice(0, 1).map((field) => ({ check, field })));
        return `<div><h3>Example audit rows</h3><div class="resource-list">${rows.map(({ check, field }) => `<div class="resource"><div><strong>${check.app_name} · ${field.field}</strong><div class="muted">${field.issue_found}</div></div><span class="badge ${badgeClass(field.initial_result)}">${titleize(field.initial_result)}</span></div>`).join("")}</div></div>`;
      }

      if (PAGE === "home") homePage();
      if (PAGE === "dataset") datasetPage();
      if (PAGE === "workflow") workflowPage();
    </script>
  </body>
</html>
